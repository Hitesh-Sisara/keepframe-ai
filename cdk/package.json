{
  "name": "keepframe-cdk",
  "version": "0.1.0",
  "private": true,
  "description": "KeepFrame infrastructure (AWS CDK v2, Arm64 only)",
  "engines": {
    "node": ">=22 <23"
  },
  "bin": {
    "keepframe": "bin/keepframe.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "cdk synth --quiet",
    "test": "TS_NODE_TRANSPILE_ONLY=true node --require ts-node/register --test test/*.test.ts",
    "cdk": "cdk"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "aws-cdk": "2.1144.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
