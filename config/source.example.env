# OPTIONAL: import an event from any S3-compatible store (the SyncSource step, `sync_source: true`).
# Not needed for the default path, where the photographer uploads straight to s3://<work bucket>/raw/<eventId>/.
# Names only: the values are operator-held and never committed. Copy outside the repo, fill in, then
# `set -a; . <file>; set +a`. keepframe/io/source.py documents each one; none has a default in code.

# S3-compatible endpoint of the source store (empty = AWS S3) and its region
SOURCE_S3_ENDPOINT_URL=
SOURCE_REGION=

# Credentials: on AWS they live in Secrets Manager keepframe/source (keys SOURCE_ACCESS_KEY_ID,
# SOURCE_SECRET_ACCESS_KEY) and are injected into the sync task. Locally, export them from this file.
SOURCE_ACCESS_KEY_ID=
SOURCE_SECRET_ACCESS_KEY=

# Source buckets (read with GET / HEAD / LIST only)
SOURCE_BUCKET_PROCESSED=
SOURCE_BUCKET_ORIGINALS=
SOURCE_BUCKET_EXIF_RICH=
SOURCE_BUCKET_EXIF_SMALL=

# Base URLs, used only to build manifest URL strings (never fetched)
SOURCE_CDN_PROCESSED=
SOURCE_CDN_ORIGINALS=

# Optional manifest export tooling (scripts/*_n1ql.py): Couchbase bucket / Postgres table holding the source
# documents (read-only queries)
SOURCE_DB_KEYSPACE=

# Path to the source database's env file holding CLUSTER_URL / CLUSTER_USER / SECRET_COUCHBASE_API_PWD
# (operator-held, never committed). Only needed when COUCHBASE_URL / _USER / _PASSWORD are not exported.
SOURCE_APIS_ENV=

# The original event-selection seed (operator-held). scripts/pick_events_n1ql.py requires it so that the
# deterministic selection of E01-E12 reproduces exactly.
SOURCE_SELECTION_SEED=
